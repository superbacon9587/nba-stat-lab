# Copy to .streamlit/secrets.toml for local runs (that file is git-ignored),
# or paste these lines into Streamlit Community Cloud: App settings -> Secrets.
# Leave ANTHROPIC_API_KEY out (or as-is) to run with the rule-based parser only.

ANTHROPIC_API_KEY = "sk-ant-..."
# Model for the question parser (Claude Haiku 4.5 is the default).
NBALAB_PARSER_MODEL = "claude-haiku-4-5"

# Hugging Face dataset holding data/deploy/ (see docs/deploy.md).
NBALAB_DATA_REPO = "yourname/nbalab-data"
# Read-only token; only needed if the dataset is private.
HF_TOKEN = "hf_..."

# Optional limits on LLM-parsed questions (defaults shown).
NBALAB_LLM_PER_SESSION_PER_HOUR = "20"
NBALAB_LLM_PER_APP_PER_HOUR = "200"

# Optional: set to "1" to skip the on_court table if the app runs out of memory.
# NBALAB_SKIP_ON_COURT = "1"
